# Destinatar temporar pentru test. În producție: office@romgreen.eu
RECIPIENT=izabela.oprea@upb.ro

# Datele serverului SMTP al adresei expeditoare.
# Pentru Google Workspace: smtp.gmail.com, port 587 și o App Password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls pentru portul 587; ssl pentru portul 465
SMTP_SECURITY=starttls
SMTP_FROM=alerts@example.com
SMTP_PASSWORD=replace-with-secret

# Intervalul de căutare la fiecare rulare; păstrează-l peste frecvența cronului.
LOOKBACK_HOURS=72
DATA_DIR=/app/data

# Obligatoriu pentru dashboard. Alege o parolă lungă, unică.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
PORT=8080
